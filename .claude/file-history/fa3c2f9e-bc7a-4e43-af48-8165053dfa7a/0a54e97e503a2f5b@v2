namespace Aurora.Core.Entities;

public class Issuer : BaseEntity
{
    public string IssuerCode { get; set; } = string.Empty;
    public string IssuerName { get; set; } = string.Empty;
    public string CountryOfRisk { get; set; } = string.Empty;
    public string Sector { get; set; } = string.Empty;
    public string Industry { get; set; } = string.Empty;

    public ICollection<Security> Securities { get; set; } = new List<Security>();
}
