using Aurora.AllocationEngine.Interfaces;
using Aurora.AllocationEngine.Models;
using Microsoft.Extensions.Logging;

namespace Aurora.AllocationEngine.Strategies;

public class TargetedAllocationStrategy : IAllocationStrategy
{
    private readonly ILogger<TargetedAllocationStrategy> _logger;

    public TargetedAllocationStrategy(ILogger<TargetedAllocationStrategy> logger)
    {
        _logger = logger;
    }

    public async Task<List<AllocationResult>> AllocateAsync(AllocationRequest request, CancellationToken cancellationToken = default)
    {
        _logger.LogInformation("Executing Targeted allocation for trade {TradeRef}", request.Trade.TradeReference);

        var allocations = new List<AllocationResult>();

        // Get only funds that passed compliance
        var eligibleFunds = request.ComplianceResults.FundResults
            .Where(f => f.Passed)
            .OrderByDescending(f => f.AvailableCapacity) // Prioritize funds with highest capacity
            .ToList();

        if (!eligibleFunds.Any())
        {
            _logger.LogWarning("No eligible funds for allocation");
            return allocations;
        }

        var remainingAmount = request.Trade.TotalTradeAmount;

        foreach (var fundResult in eligibleFunds)
        {
            if (remainingAmount <= 0)
                break;

            var fund = fundResult.Fund;
            var effectiveCapacity = Math.Min(fundResult.AvailableCapacity, fund.AvailableCash);

            // Allocate as much as possible to this fund
            var allocatedAmount = Math.Min(remainingAmount, effectiveCapacity);

            if (allocatedAmount > 0)
            {
                allocations.Add(new AllocationResult
                {
                    Fund = fund,
                    AllocatedAmount = allocatedAmount,
                    AllocatedQuantity = allocatedAmount / request.Trade.Price,
                    AllocationPercentage = (allocatedAmount / request.Trade.TotalTradeAmount) * 100,
                    AvailableCapacity = fundResult.AvailableCapacity,
                    AllocationReason = $"Targeted allocation - filled to capacity"
                });

                remainingAmount -= allocatedAmount;
            }
        }

        _logger.LogInformation("Targeted allocation completed: {FundCount} funds, Total: {Total:C}, Remaining: {Remaining:C}",
            allocations.Count, allocations.Sum(a => a.AllocatedAmount), remainingAmount);

        return await Task.FromResult(allocations);
    }
}
