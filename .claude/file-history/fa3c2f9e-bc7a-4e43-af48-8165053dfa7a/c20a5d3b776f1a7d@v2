using Aurora.Core.Enums;

namespace Aurora.Core.DTOs;

public class TradeBookingResponse
{
    public bool Success { get; set; }
    public Guid? TradeId { get; set; }
    public TradeStatus Status { get; set; }
    public string Message { get; set; } = string.Empty;

    public ComplianceCheckSummary? ComplianceCheckSummary { get; set; }
    public AllocationSummary? AllocationSummary { get; set; }
    public List<string> Errors { get; set; } = new List<string>();
    public List<AuditEntry> AuditTrail { get; set; } = new List<AuditEntry>();
}

public class ComplianceCheckSummary
{
    public bool AllPassed { get; set; }
    public int TotalRulesChecked { get; set; }
    public int RulesPassed { get; set; }
    public int RulesFailed { get; set; }
    public int SoftLimitBreaches { get; set; }
    public int HardLimitBreaches { get; set; }
    public List<ComplianceCheckResultDto> Results { get; set; } = new List<ComplianceCheckResultDto>();
    public TimeSpan ExecutionTime { get; set; }
}

public class ComplianceCheckResultDto
{
    public Guid FundId { get; set; }
    public string FundCode { get; set; } = string.Empty;
    public bool Passed { get; set; }
    public string RuleCode { get; set; } = string.Empty;
    public string RuleName { get; set; } = string.Empty;
    public string Severity { get; set; } = string.Empty;
    public decimal? CalculatedCapacity { get; set; }
    public string Message { get; set; } = string.Empty;
}

public class AllocationSummary
{
    public bool Success { get; set; }
    public int TotalFunds { get; set; }
    public int FundsAllocated { get; set; }
    public decimal TotalAllocated { get; set; }
    public decimal TotalRequested { get; set; }
    public List<AllocationResultDto> Allocations { get; set; } = new List<AllocationResultDto>();
    public TimeSpan ExecutionTime { get; set; }
}

public class AllocationResultDto
{
    public Guid FundId { get; set; }
    public string FundCode { get; set; } = string.Empty;
    public decimal AllocatedAmount { get; set; }
    public decimal AllocationPercentage { get; set; }
    public decimal AvailableCapacity { get; set; }
    public string AllocationReason { get; set; } = string.Empty;
}

public class AuditEntry
{
    public string Module { get; set; } = string.Empty;
    public string Action { get; set; } = string.Empty;
    public string Details { get; set; } = string.Empty;
    public DateTime Timestamp { get; set; }
}
