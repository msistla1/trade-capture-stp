using Aurora.Core.Enums;

namespace Aurora.Core.Entities;

public class Trade : BaseEntity
{
    public string TradeReference { get; set; } = string.Empty;
    public Guid SecurityId { get; set; }
    public Security? Security { get; set; }
    public Guid CounterpartyId { get; set; }
    public Counterparty? Counterparty { get; set; }
    public Guid StrategyId { get; set; }
    public Strategy? Strategy { get; set; }

    public decimal TotalTradeAmount { get; set; }
    public decimal Price { get; set; }
    public decimal Quantity { get; set; }
    public DateTime TradeDate { get; set; }
    public DateTime SettlementDate { get; set; }

    public MarketType MarketType { get; set; }
    public string TransactionType { get; set; } = string.Empty; // Buy, Sell
    public AllocationMethodology AllocationMethodology { get; set; }
    public TradeStatus Status { get; set; } = TradeStatus.Draft;

    public string? ComplianceCheckSummary { get; set; }
    public string? AllocationSummary { get; set; }
    public string? FailureReason { get; set; }

    public ICollection<TradeAllocation> Allocations { get; set; } = new List<TradeAllocation>();
    public ICollection<ComplianceCheckResult> ComplianceCheckResults { get; set; } = new List<ComplianceCheckResult>();
}
