using System.Diagnostics;
using Aurora.ComplianceEngine.Interfaces;
using Aurora.ComplianceEngine.Models;
using Aurora.Core.Entities;
using Aurora.Core.Enums;
using Aurora.Core.Interfaces;
using DynamicExpresso;
using Microsoft.Extensions.Logging;

namespace Aurora.ComplianceEngine.Services;

public class ComplianceEngineService : IComplianceEngine
{
    private readonly IRepository<ComplianceRule> _ruleRepository;
    private readonly IRepository<FundHolding> _holdingRepository;
    private readonly IAuditLogger _auditLogger;
    private readonly ILogger<ComplianceEngineService> _logger;

    public ComplianceEngineService(
        IRepository<ComplianceRule> ruleRepository,
        IRepository<FundHolding> holdingRepository,
        IAuditLogger auditLogger,
        ILogger<ComplianceEngineService> logger)
    {
        _ruleRepository = ruleRepository;
        _holdingRepository = holdingRepository;
        _auditLogger = auditLogger;
        _logger = logger;
    }

    public async Task<ComplianceCheckResponse> CheckComplianceAsync(
        ComplianceCheckRequest request,
        CancellationToken cancellationToken = default)
    {
        var stopwatch = Stopwatch.StartNew();
        _logger.LogInformation("Starting compliance check for trade {TradeRef}", request.Trade.TradeReference);

        var response = new ComplianceCheckResponse();

        try
        {
            // Run compliance checks for all funds in parallel
            var tasks = request.Funds.Select(fund =>
                CheckFundComplianceAsync(fund, request, cancellationToken));

            var fundResults = await Task.WhenAll(tasks);
            response.FundResults = fundResults.ToList();
            response.AllPassed = fundResults.All(r => r.Passed);

            stopwatch.Stop();
            response.ExecutionTime = stopwatch.Elapsed;

            await _auditLogger.LogAsync(
                "ComplianceEngine",
                "ComplianceCheck",
                "Trade",
                request.Trade.Id.ToString(),
                $"Checked {request.Funds.Count} funds, AllPassed={response.AllPassed}",
                request.Trade.Id);

            _logger.LogInformation(
                "Compliance check completed for trade {TradeRef} in {ElapsedMs}ms. Result: {AllPassed}",
                request.Trade.TradeReference,
                stopwatch.ElapsedMilliseconds,
                response.AllPassed);

            return response;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error during compliance check for trade {TradeRef}", request.Trade.TradeReference);
            throw;
        }
    }

    private async Task<FundComplianceResult> CheckFundComplianceAsync(
        Fund fund,
        ComplianceCheckRequest request,
        CancellationToken cancellationToken)
    {
        var result = new FundComplianceResult
        {
            Fund = fund,
            Passed = true,
            AvailableCapacity = decimal.MaxValue
        };

        // Get all active compliance rules for this fund
        var rules = await _ruleRepository.FindAsync(
            r => r.FundId == fund.Id && r.IsActive && !r.IsDeleted,
            cancellationToken);

        var rulesList = rules.OrderBy(r => r.Priority).ToList();

        _logger.LogDebug("Evaluating {RuleCount} compliance rules for fund {FundCode}", rulesList.Count, fund.FundCode);

        foreach (var rule in rulesList)
        {
            var ruleResult = await EvaluateRuleAsync(rule, fund, request, cancellationToken);
            result.RuleResults.Add(ruleResult);

            if (!ruleResult.Passed)
            {
                if (rule.Severity == ComplianceRuleSeverity.Hard)
                {
                    result.Passed = false;
                    result.AvailableCapacity = 0;
                    _logger.LogWarning("Hard limit breach for fund {FundCode}, rule {RuleCode}", fund.FundCode, rule.RuleCode);
                    break; // Stop on first hard limit breach
                }
            }

            // Track minimum capacity across all rules
            if (ruleResult.CalculatedCapacity.HasValue)
            {
                result.AvailableCapacity = Math.Min(result.AvailableCapacity, ruleResult.CalculatedCapacity.Value);
            }
        }

        return result;
    }

    private async Task<RuleEvaluationResult> EvaluateRuleAsync(
        ComplianceRule rule,
        Fund fund,
        ComplianceCheckRequest request,
        CancellationToken cancellationToken)
    {
        var ruleResult = new RuleEvaluationResult
        {
            Rule = rule,
            LimitValue = rule.LimitValue
        };

        try
        {
            switch (rule.RuleLevel)
            {
                case ComplianceRuleLevel.Trade:
                    await EvaluateTradeLevelRuleAsync(rule, fund, request, ruleResult, cancellationToken);
                    break;

                case ComplianceRuleLevel.Asset:
                    await EvaluateAssetLevelRuleAsync(rule, fund, request, ruleResult, cancellationToken);
                    break;

                case ComplianceRuleLevel.Issuer:
                    await EvaluateIssuerLevelRuleAsync(rule, fund, request, ruleResult, cancellationToken);
                    break;
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error evaluating rule {RuleCode} for fund {FundCode}", rule.RuleCode, fund.FundCode);
            ruleResult.Passed = false;
            ruleResult.Message = $"Error evaluating rule: {ex.Message}";
        }

        return ruleResult;
    }

    private async Task EvaluateTradeLevelRuleAsync(
        ComplianceRule rule,
        Fund fund,
        ComplianceCheckRequest request,
        RuleEvaluationResult result,
        CancellationToken cancellationToken)
    {
        // Trade-level rules: transaction type, counterparty restrictions, etc.
        var interpreter = new Interpreter();

        // Set up context for expression evaluation
        interpreter.SetVariable("trade", request.Trade);
        interpreter.SetVariable("fund", fund);
        interpreter.SetVariable("security", request.Security);
        interpreter.SetVariable("transactionType", request.Trade.TransactionType);
        interpreter.SetVariable("counterparty", request.Trade.Counterparty?.CounterpartyName ?? "");

        try
        {
            var evaluationResult = interpreter.Eval<bool>(rule.RuleExpression);
            result.Passed = evaluationResult;

            if (!evaluationResult)
            {
                result.Message = $"Trade-level restriction: {rule.RuleName}";
                result.DetailedMessage = rule.Description;
                result.CalculatedCapacity = 0;
            }
            else
            {
                result.Message = $"Trade-level check passed: {rule.RuleName}";
                result.CalculatedCapacity = request.Trade.TotalTradeAmount; // No restriction
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Expression evaluation failed for rule {RuleCode}", rule.RuleCode);
            result.Passed = false;
            result.Message = $"Expression error: {ex.Message}";
        }

        await Task.CompletedTask;
    }

    private async Task EvaluateAssetLevelRuleAsync(
        ComplianceRule rule,
        Fund fund,
        ComplianceCheckRequest request,
        RuleEvaluationResult result,
        CancellationToken cancellationToken)
    {
        // Asset-level rules: rating restrictions, asset class limits, etc.
        var currentHoldings = await _holdingRepository.FindAsync(
            h => h.FundId == fund.Id && h.SecurityId == request.Security.Id && !h.IsDeleted,
            cancellationToken);

        var currentValue = currentHoldings.Sum(h => h.MarketValue);
        result.CurrentValue = currentValue;

        // Check if this is a rating restriction
        if (rule.RuleExpression.Contains("rating", StringComparison.OrdinalIgnoreCase))
        {
            var interpreter = new Interpreter();
            interpreter.SetVariable("rating", request.Security.Rating ?? "");
            interpreter.SetVariable("assetClass", request.Security.AssetClass);
            interpreter.SetVariable("securityType", request.Security.SecurityType);

            try
            {
                var evaluationResult = interpreter.Eval<bool>(rule.RuleExpression);
                result.Passed = evaluationResult;

                if (!evaluationResult)
                {
                    result.Message = $"Asset restriction: {rule.RuleName}";
                    result.DetailedMessage = $"Security {request.Security.SecurityName} does not meet criteria: {rule.Description}";
                    result.CalculatedCapacity = 0;
                }
                else
                {
                    result.Message = $"Asset check passed: {rule.RuleName}";
                    result.CalculatedCapacity = CalculateCapacityForPercentageLimit(rule, fund, currentValue, request.Trade.TotalTradeAmount);
                }
            }
            catch
            {
                result.Passed = false;
                result.Message = "Expression evaluation error";
            }
        }
        else
        {
            // Percentage-based limit (e.g., no more than X% of NAV in a single security)
            result.CalculatedCapacity = CalculateCapacityForPercentageLimit(rule, fund, currentValue, request.Trade.TotalTradeAmount);

            if (rule.LimitType == LimitType.Max)
            {
                result.Passed = result.CalculatedCapacity >= 0;
                result.Message = result.Passed
                    ? $"Asset concentration check passed: {rule.RuleName}"
                    : $"Asset concentration limit exceeded: {rule.RuleName}";
            }
            else
            {
                result.Passed = true; // Min limits don't block trades
                result.Message = $"Minimum asset exposure tracked: {rule.RuleName}";
            }
        }
    }

    private async Task EvaluateIssuerLevelRuleAsync(
        ComplianceRule rule,
        Fund fund,
        ComplianceCheckRequest request,
        RuleEvaluationResult result,
        CancellationToken cancellationToken)
    {
        // Issuer-level rules: issuer concentration, country of risk, sector limits
        var issuerHoldings = await _holdingRepository.FindAsync(
            h => h.FundId == fund.Id && h.IssuerId == request.Issuer.Id && !h.IsDeleted,
            cancellationToken);

        var currentValue = issuerHoldings.Sum(h => h.MarketValue);
        result.CurrentValue = currentValue;

        // Check for country/sector restrictions
        if (rule.RuleExpression.Contains("country", StringComparison.OrdinalIgnoreCase) ||
            rule.RuleExpression.Contains("sector", StringComparison.OrdinalIgnoreCase))
        {
            var interpreter = new Interpreter();
            interpreter.SetVariable("countryOfRisk", request.Issuer.CountryOfRisk);
            interpreter.SetVariable("sector", request.Issuer.Sector);
            interpreter.SetVariable("industry", request.Issuer.Industry);

            try
            {
                var evaluationResult = interpreter.Eval<bool>(rule.RuleExpression);
                result.Passed = evaluationResult;

                if (!evaluationResult)
                {
                    result.Message = $"Issuer restriction: {rule.RuleName}";
                    result.DetailedMessage = $"Issuer {request.Issuer.IssuerName} does not meet criteria: {rule.Description}";
                    result.CalculatedCapacity = 0;
                }
                else
                {
                    result.Message = $"Issuer check passed: {rule.RuleName}";
                    result.CalculatedCapacity = CalculateCapacityForPercentageLimit(rule, fund, currentValue, request.Trade.TotalTradeAmount);
                }
            }
            catch
            {
                result.Passed = false;
                result.Message = "Expression evaluation error";
            }
        }
        else
        {
            // Issuer concentration limit (e.g., no more than X% of NAV in a single issuer)
            result.CalculatedCapacity = CalculateCapacityForPercentageLimit(rule, fund, currentValue, request.Trade.TotalTradeAmount);

            if (rule.LimitType == LimitType.Max)
            {
                result.Passed = result.CalculatedCapacity >= 0;
                result.Message = result.Passed
                    ? $"Issuer concentration check passed: {rule.RuleName}"
                    : $"Issuer concentration limit exceeded: {rule.RuleName}";

                result.DetailedMessage = $"Current issuer exposure: {currentValue:C}, " +
                    $"Percentage of NAV: {(currentValue / fund.CurrentNAV * 100):F2}%, " +
                    $"Limit: {rule.LimitValue}%, " +
                    $"Available capacity: {result.CalculatedCapacity:C}";
            }
            else
            {
                result.Passed = true;
                result.Message = $"Minimum issuer exposure tracked: {rule.RuleName}";
            }
        }
    }

    private decimal CalculateCapacityForPercentageLimit(
        ComplianceRule rule,
        Fund fund,
        decimal currentValue,
        decimal proposedTradeAmount)
    {
        if (!rule.LimitValue.HasValue || fund.CurrentNAV == 0)
            return decimal.MaxValue;

        // Calculate max allowed value based on percentage limit
        var maxAllowedValue = fund.CurrentNAV * (rule.LimitValue.Value / 100m);

        // Calculate available capacity
        var availableCapacity = maxAllowedValue - currentValue;

        return Math.Max(0, availableCapacity);
    }
}
