using Aurora.AllocationEngine.Models;
using Aurora.AllocationEngine.Strategies;
using Aurora.ComplianceEngine.Models;
using Aurora.Core.DTOs;
using Aurora.Core.Entities;
using Aurora.Core.Enums;
using FluentAssertions;
using Microsoft.Extensions.Logging;
using Moq;
using Xunit;

namespace Aurora.Tests;

public class AllocationEngineTests
{
    private readonly Mock<ILogger<ProRataAllocationStrategy>> _proRataLogger;
    private readonly Mock<ILogger<TargetedAllocationStrategy>> _targetedLogger;
    private readonly Mock<ILogger<CustomAllocationStrategy>> _customLogger;

    public AllocationEngineTests()
    {
        _proRataLogger = new Mock<ILogger<ProRataAllocationStrategy>>();
        _targetedLogger = new Mock<ILogger<TargetedAllocationStrategy>>();
        _customLogger = new Mock<ILogger<CustomAllocationStrategy>>();
    }

    [Fact]
    public async Task ProRataAllocation_ShouldDistributeProportionally()
    {
        // Arrange
        var strategy = new ProRataAllocationStrategy(_proRataLogger.Object);

        var fund1 = new Fund { Id = Guid.NewGuid(), FundCode = "FUND001", AvailableCash = 1000000m, CurrentNAV = 10000000m };
        var fund2 = new Fund { Id = Guid.NewGuid(), FundCode = "FUND002", AvailableCash = 2000000m, CurrentNAV = 20000000m };
        var fund3 = new Fund { Id = Guid.NewGuid(), FundCode = "FUND003", AvailableCash = 1000000m, CurrentNAV = 10000000m };

        var trade = new Trade
        {
            Id = Guid.NewGuid(),
            TradeReference = "TEST001",
            TotalTradeAmount = 3000000m,
            Price = 100m
        };

        var complianceResponse = new ComplianceCheckResponse
        {
            AllPassed = true,
            FundResults = new List<FundComplianceResult>
            {
                new FundComplianceResult { Fund = fund1, Passed = true, AvailableCapacity = 500000m },
                new FundComplianceResult { Fund = fund2, Passed = true, AvailableCapacity = 1500000m },
                new FundComplianceResult { Fund = fund3, Passed = true, AvailableCapacity = 800000m }
            }
        };

        var request = new AllocationRequest
        {
            Trade = trade,
            Methodology = AllocationMethodology.ProRata,
            ComplianceResults = complianceResponse
        };

        // Act
        var result = await strategy.AllocateAsync(request);

        // Assert
        result.Should().HaveCount(3);
        result.Sum(a => a.AllocatedAmount).Should().BeLessThanOrEqualTo(trade.TotalTradeAmount);

        // Verify proportional distribution
        var totalCapacity = 500000m + 1500000m + 800000m; // 2.8M
        var expectedTotal = Math.Min(trade.TotalTradeAmount, totalCapacity);

        result.Sum(a => a.AllocatedAmount).Should().BeApproximately(expectedTotal, 1m);
    }

    [Fact]
    public async Task TargetedAllocation_ShouldPrioritizeHighestCapacity()
    {
        // Arrange
        var strategy = new TargetedAllocationStrategy(_targetedLogger.Object);

        var fund1 = new Fund { Id = Guid.NewGuid(), FundCode = "FUND001", AvailableCash = 500000m, CurrentNAV = 10000000m };
        var fund2 = new Fund { Id = Guid.NewGuid(), FundCode = "FUND002", AvailableCash = 2000000m, CurrentNAV = 20000000m };
        var fund3 = new Fund { Id = Guid.NewGuid(), FundCode = "FUND003", AvailableCash = 800000m, CurrentNAV = 10000000m };

        var trade = new Trade
        {
            Id = Guid.NewGuid(),
            TradeReference = "TEST002",
            TotalTradeAmount = 1500000m,
            Price = 100m
        };

        var complianceResponse = new ComplianceCheckResponse
        {
            AllPassed = true,
            FundResults = new List<FundComplianceResult>
            {
                new FundComplianceResult { Fund = fund1, Passed = true, AvailableCapacity = 500000m },
                new FundComplianceResult { Fund = fund2, Passed = true, AvailableCapacity = 2000000m },
                new FundComplianceResult { Fund = fund3, Passed = true, AvailableCapacity = 800000m }
            }
        };

        var request = new AllocationRequest
        {
            Trade = trade,
            Methodology = AllocationMethodology.Targeted,
            ComplianceResults = complianceResponse
        };

        // Act
        var result = await strategy.AllocateAsync(request);

        // Assert
        result.Should().HaveCount(2); // Should fill fund2 completely, then partially fill fund3 or fund1
        result.Sum(a => a.AllocatedAmount).Should().Be(trade.TotalTradeAmount);

        // The fund with highest capacity should get the largest allocation
        var highestAllocation = result.OrderByDescending(a => a.AllocatedAmount).First();
        highestAllocation.Fund.FundCode.Should().Be("FUND002");
    }

    [Fact]
    public async Task CustomAllocation_ShouldRespectTargetedAmounts()
    {
        // Arrange
        var strategy = new CustomAllocationStrategy(_customLogger.Object);

        var fund1 = new Fund { Id = Guid.NewGuid(), FundCode = "FUND001", AvailableCash = 1000000m, CurrentNAV = 10000000m };
        var fund2 = new Fund { Id = Guid.NewGuid(), FundCode = "FUND002", AvailableCash = 2000000m, CurrentNAV = 20000000m };

        var trade = new Trade
        {
            Id = Guid.NewGuid(),
            TradeReference = "TEST003",
            TotalTradeAmount = 2000000m,
            Price = 100m
        };

        var complianceResponse = new ComplianceCheckResponse
        {
            AllPassed = true,
            FundResults = new List<FundComplianceResult>
            {
                new FundComplianceResult { Fund = fund1, Passed = true, AvailableCapacity = 1000000m },
                new FundComplianceResult { Fund = fund2, Passed = true, AvailableCapacity = 2000000m }
            }
        };

        var customAllocations = new List<CustomAllocationDto>
        {
            new CustomAllocationDto { FundId = fund1.Id, TargetAmount = 800000m, TargetPercentage = 0 },
            new CustomAllocationDto { FundId = fund2.Id, TargetAmount = 1200000m, TargetPercentage = 0 }
        };

        var request = new AllocationRequest
        {
            Trade = trade,
            Methodology = AllocationMethodology.Custom,
            ComplianceResults = complianceResponse,
            CustomAllocations = customAllocations
        };

        // Act
        var result = await strategy.AllocateAsync(request);

        // Assert
        result.Should().HaveCount(2);
        result.First(a => a.Fund.Id == fund1.Id).AllocatedAmount.Should().Be(800000m);
        result.First(a => a.Fund.Id == fund2.Id).AllocatedAmount.Should().Be(1200000m);
    }

    [Fact]
    public async Task Allocation_ShouldRespectComplianceCapacity()
    {
        // Arrange
        var strategy = new ProRataAllocationStrategy(_proRataLogger.Object);

        var fund = new Fund { Id = Guid.NewGuid(), FundCode = "FUND001", AvailableCash = 2000000m, CurrentNAV = 10000000m };

        var trade = new Trade
        {
            Id = Guid.NewGuid(),
            TradeReference = "TEST004",
            TotalTradeAmount = 2000000m,
            Price = 100m
        };

        // Fund has cash but compliance restricts capacity to 500K
        var complianceResponse = new ComplianceCheckResponse
        {
            AllPassed = true,
            FundResults = new List<FundComplianceResult>
            {
                new FundComplianceResult { Fund = fund, Passed = true, AvailableCapacity = 500000m }
            }
        };

        var request = new AllocationRequest
        {
            Trade = trade,
            Methodology = AllocationMethodology.ProRata,
            ComplianceResults = complianceResponse
        };

        // Act
        var result = await strategy.AllocateAsync(request);

        // Assert
        result.Should().HaveCount(1);
        result.First().AllocatedAmount.Should().Be(500000m); // Limited by compliance, not cash
    }

    [Fact]
    public async Task Allocation_ShouldSkipFailedComplianceFunds()
    {
        // Arrange
        var strategy = new ProRataAllocationStrategy(_proRataLogger.Object);

        var fund1 = new Fund { Id = Guid.NewGuid(), FundCode = "FUND001", AvailableCash = 1000000m, CurrentNAV = 10000000m };
        var fund2 = new Fund { Id = Guid.NewGuid(), FundCode = "FUND002", AvailableCash = 2000000m, CurrentNAV = 20000000m };

        var trade = new Trade
        {
            Id = Guid.NewGuid(),
            TradeReference = "TEST005",
            TotalTradeAmount = 2000000m,
            Price = 100m
        };

        var complianceResponse = new ComplianceCheckResponse
        {
            AllPassed = false,
            FundResults = new List<FundComplianceResult>
            {
                new FundComplianceResult { Fund = fund1, Passed = false, AvailableCapacity = 0 },
                new FundComplianceResult { Fund = fund2, Passed = true, AvailableCapacity = 1500000m }
            }
        };

        var request = new AllocationRequest
        {
            Trade = trade,
            Methodology = AllocationMethodology.ProRata,
            ComplianceResults = complianceResponse
        };

        // Act
        var result = await strategy.AllocateAsync(request);

        // Assert
        result.Should().HaveCount(1);
        result.First().Fund.FundCode.Should().Be("FUND002");
        result.First().AllocatedAmount.Should().Be(1500000m);
    }
}
