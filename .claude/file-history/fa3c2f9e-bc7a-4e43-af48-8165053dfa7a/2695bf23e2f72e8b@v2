using System.Text.Json;
using Aurora.Core.DTOs;
using Aurora.Core.Entities;
using Aurora.Core.Interfaces;
using Aurora.Infrastructure.Data;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;

namespace Aurora.Infrastructure.Services;

public class AuditLoggerService : IAuditLogger
{
    private readonly AuroraDbContext _context;
    private readonly ILogger<AuditLoggerService> _logger;

    public AuditLoggerService(AuroraDbContext context, ILogger<AuditLoggerService> logger)
    {
        _context = context;
        _logger = logger;
    }

    public async Task LogAsync(string module, string action, string entityType, string entityId, string details, Guid? tradeId = null, string? userId = null)
    {
        try
        {
            var auditLog = new AuditLog
            {
                Module = module,
                Action = action,
                EntityType = entityType,
                EntityId = entityId,
                Details = details,
                TradeId = tradeId,
                UserId = userId,
                Timestamp = DateTime.UtcNow
            };

            await _context.AuditLogs.AddAsync(auditLog);
            await _context.SaveChangesAsync();

            _logger.LogDebug("Audit log created: {Module} - {Action} - {EntityId}", module, action, entityId);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to create audit log for {Module} - {Action}", module, action);
        }
    }

    public async Task<IEnumerable<AuditEntry>> GetAuditTrailAsync(Guid tradeId)
    {
        var logs = await _context.AuditLogs
            .Where(a => a.TradeId == tradeId)
            .OrderBy(a => a.Timestamp)
            .ToListAsync();

        return logs.Select(l => new AuditEntry
        {
            Module = l.Module,
            Action = l.Action,
            Details = l.Details,
            Timestamp = l.Timestamp
        });
    }
}
