using Microsoft.Extensions.Logging;
using TradeWorkflow.Application.Contracts;
using TradeWorkflow.Application.StateMachine;
using TradeWorkflow.Domain.Entities;
using TradeWorkflow.Domain.Enums;

namespace TradeWorkflow.Application.Services;

public class TradeWorkflowService
{
    private readonly ITradeRepository _tradeRepository;
    private readonly ITradeHistoryRepository _tradeHistoryRepository;
    private readonly IValidationService _validationService;
    private readonly IDuplicateCheckService _duplicateCheckService;
    private readonly ITradeProcessingService _tradeProcessingService;
    private readonly ILogger<TradeStateMachine> _stateMachineLogger;

    public TradeWorkflowService(
        ITradeRepository tradeRepository,
        ITradeHistoryRepository tradeHistoryRepository,
        IValidationService validationService,
        IDuplicateCheckService duplicateCheckService,
        ITradeProcessingService tradeProcessingService,
        ILogger<TradeStateMachine> stateMachineLogger)
    {
        _tradeRepository = tradeRepository;
        _tradeHistoryRepository = tradeHistoryRepository;
        _validationService = validationService;
        _duplicateCheckService = duplicateCheckService;
        _tradeProcessingService = tradeProcessingService;
        _stateMachineLogger = stateMachineLogger;
    }

    public async Task<Trade> CreateTradeAsync(Trade trade)
    {
        trade.Id = Guid.NewGuid();
        trade.CurrentState = TcrState.Received;
        trade.CreatedAt = DateTime.UtcNow;
        trade.UpdatedAt = DateTime.UtcNow;

        var createdTrade = await _tradeRepository.CreateAsync(trade);
        await _tradeRepository.SaveChangesAsync();

        return createdTrade;
    }

    public async Task<Trade?> GetTradeAsync(Guid tradeId)
    {
        return await _tradeRepository.GetByIdAsync(tradeId);
    }

    public async Task<IEnumerable<Trade>> GetAllTradesAsync()
    {
        return await _tradeRepository.GetAllAsync();
    }

    public async Task<TcrState> ProcessTriggerAsync(Guid tradeId, TcrTrigger trigger)
    {
        var trade = await _tradeRepository.GetByIdAsync(tradeId);
        if (trade == null)
        {
            throw new InvalidOperationException($"Trade with ID {tradeId} not found");
        }

        var stateMachine = CreateStateMachine(trade);
        return await stateMachine.FireAsync(trigger);
    }

    public async Task<IEnumerable<TcrTrigger>> GetPermittedTriggersAsync(Guid tradeId)
    {
        var trade = await _tradeRepository.GetByIdAsync(tradeId);
        if (trade == null)
        {
            throw new InvalidOperationException($"Trade with ID {tradeId} not found");
        }

        var stateMachine = CreateStateMachine(trade);
        return stateMachine.PermittedTriggers;
    }

    public async Task<IEnumerable<TradeHistory>> GetTradeHistoryAsync(Guid tradeId)
    {
        return await _tradeHistoryRepository.GetByTradeIdAsync(tradeId);
    }

    private TradeStateMachine CreateStateMachine(Trade trade)
    {
        return new TradeStateMachine(
            trade,
            _validationService,
            _duplicateCheckService,
            _tradeProcessingService,
            _tradeRepository,
            _tradeHistoryRepository,
            _stateMachineLogger);
    }
}
