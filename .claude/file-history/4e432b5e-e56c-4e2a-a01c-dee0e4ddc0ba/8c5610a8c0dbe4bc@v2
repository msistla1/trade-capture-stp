using FluentAssertions;
using TradeWorkflow.Domain.Enums;
using TradeWorkflow.Tests.Builders;
using Xunit;

namespace TradeWorkflow.Tests.Domain;

public class TradeTests
{
    [Fact]
    public void HasRequiredFields_WhenAllFieldsPresent_ReturnsTrue()
    {
        // Arrange
        var trade = TradeBuilder.Default().Build();

        // Act
        var result = trade.HasRequiredFields();

        // Assert
        result.Should().BeTrue();
    }

    [Theory]
    [InlineData("", "AAPL", "ABC Corp", 100, 150)]
    [InlineData("TRD-001", "", "ABC Corp", 100, 150)]
    [InlineData("TRD-001", "AAPL", "", 100, 150)]
    [InlineData("TRD-001", "AAPL", "ABC Corp", 0, 150)]
    [InlineData("TRD-001", "AAPL", "ABC Corp", 100, 0)]
    public void HasRequiredFields_WhenFieldMissing_ReturnsFalse(
        string tradeRef, string instrument, string counterparty, decimal quantity, decimal price)
    {
        // Arrange
        var trade = TradeBuilder.Default()
            .WithTradeReference(tradeRef)
            .WithInstrument(instrument)
            .WithCounterparty(counterparty)
            .WithQuantity(quantity)
            .WithPrice(price)
            .Build();

        // Act
        var result = trade.HasRequiredFields();

        // Assert
        result.Should().BeFalse();
    }

    [Fact]
    public void IsRetryable_WhenRetryCountBelowMax_ReturnsTrue()
    {
        // Arrange
        var trade = TradeBuilder.Default()
            .WithRetryCount(2)
            .WithMaxRetries(3)
            .Build();

        // Act
        var result = trade.IsRetryable();

        // Assert
        result.Should().BeTrue();
    }

    [Fact]
    public void IsRetryable_WhenRetryCountEqualsMax_ReturnsFalse()
    {
        // Arrange
        var trade = TradeBuilder.Default()
            .WithRetryCount(3)
            .WithMaxRetries(3)
            .Build();

        // Act
        var result = trade.IsRetryable();

        // Assert
        result.Should().BeFalse();
    }

    [Fact]
    public void IsRetryable_WhenRetryCountExceedsMax_ReturnsFalse()
    {
        // Arrange
        var trade = TradeBuilder.Default()
            .WithRetryCount(4)
            .WithMaxRetries(3)
            .Build();

        // Act
        var result = trade.IsRetryable();

        // Assert
        result.Should().BeFalse();
    }

    [Fact]
    public void Trade_DefaultState_ShouldBeReceived()
    {
        // Arrange & Act
        var trade = TradeBuilder.Default().Build();

        // Assert
        trade.CurrentState.Should().Be(TcrState.Received);
    }

    [Fact]
    public void Trade_CanSetAndGetProperties()
    {
        // Arrange
        var tradeId = Guid.NewGuid();
        var tradeDate = DateTime.UtcNow;

        // Act
        var trade = TradeBuilder.Default()
            .WithId(tradeId)
            .WithTradeReference("TRD-002")
            .WithInstrument("MSFT")
            .WithQuantity(200)
            .WithPrice(250.75m)
            .WithCounterparty("XYZ Corp")
            .WithTradeDate(tradeDate)
            .WithTradeType("Sell")
            .WithState(TcrState.ValidationInProgress)
            .Build();

        // Assert
        trade.Id.Should().Be(tradeId);
        trade.TradeReference.Should().Be("TRD-002");
        trade.Instrument.Should().Be("MSFT");
        trade.Quantity.Should().Be(200);
        trade.Price.Should().Be(250.75m);
        trade.Counterparty.Should().Be("XYZ Corp");
        trade.TradeDate.Should().Be(tradeDate);
        trade.TradeType.Should().Be("Sell");
        trade.CurrentState.Should().Be(TcrState.ValidationInProgress);
    }
}
