using TradeWorkflow.Domain.Enums;

namespace TradeWorkflow.Domain.Entities;

public class Trade
{
    public Guid Id { get; set; }
    public string TradeReference { get; set; } = string.Empty;
    public TcrState CurrentState { get; set; }

    // Trade details
    public string Instrument { get; set; } = string.Empty;
    public decimal Quantity { get; set; }
    public decimal Price { get; set; }
    public string Counterparty { get; set; } = string.Empty;
    public DateTime TradeDate { get; set; }
    public string TradeType { get; set; } = string.Empty;

    // Workflow tracking
    public bool IsValidated { get; set; }
    public bool IsDuplicate { get; set; }
    public string? ValidationErrors { get; set; }
    public int RetryCount { get; set; }
    public int MaxRetries { get; set; } = 3;

    // Audit fields
    public DateTime CreatedAt { get; set; }
    public DateTime UpdatedAt { get; set; }
    public string? ErrorMessage { get; set; }

    // Business logic methods
    public bool HasRequiredFields()
    {
        return !string.IsNullOrWhiteSpace(TradeReference) &&
               !string.IsNullOrWhiteSpace(Instrument) &&
               !string.IsNullOrWhiteSpace(Counterparty) &&
               Quantity > 0 &&
               Price > 0;
    }

    public bool IsRetryable()
    {
        return RetryCount < MaxRetries;
    }
}
