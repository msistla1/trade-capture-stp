using TradeWorkflow.Domain.Enums;

namespace TradeWorkflow.API.Models;

public class TradeResponse
{
    public Guid Id { get; set; }
    public string TradeReference { get; set; } = string.Empty;
    public TcrState CurrentState { get; set; }
    public string Instrument { get; set; } = string.Empty;
    public decimal Quantity { get; set; }
    public decimal Price { get; set; }
    public string Counterparty { get; set; } = string.Empty;
    public DateTime TradeDate { get; set; }
    public string TradeType { get; set; } = string.Empty;
    public bool IsValidated { get; set; }
    public bool IsDuplicate { get; set; }
    public string? ValidationErrors { get; set; }
    public int RetryCount { get; set; }
    public DateTime CreatedAt { get; set; }
    public DateTime UpdatedAt { get; set; }
    public string? ErrorMessage { get; set; }
    public IEnumerable<TcrTrigger> PermittedTriggers { get; set; } = Array.Empty<TcrTrigger>();
}
