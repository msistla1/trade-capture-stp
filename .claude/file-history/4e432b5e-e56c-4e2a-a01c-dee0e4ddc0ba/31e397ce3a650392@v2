using Microsoft.Extensions.Logging;
using Stateless;
using TradeWorkflow.Application.Contracts;
using TradeWorkflow.Domain.Entities;
using TradeWorkflow.Domain.Enums;

namespace TradeWorkflow.Application.StateMachine;

public class TradeStateMachine
{
    private readonly StateMachine<TcrState, TcrTrigger> _machine;
    private readonly Trade _trade;
    private readonly IValidationService _validationService;
    private readonly IDuplicateCheckService _duplicateCheckService;
    private readonly ITradeProcessingService _tradeProcessingService;
    private readonly ITradeRepository _tradeRepository;
    private readonly ITradeHistoryRepository _tradeHistoryRepository;
    private readonly ILogger<TradeStateMachine> _logger;

    public TradeStateMachine(
        Trade trade,
        IValidationService validationService,
        IDuplicateCheckService duplicateCheckService,
        ITradeProcessingService tradeProcessingService,
        ITradeRepository tradeRepository,
        ITradeHistoryRepository tradeHistoryRepository,
        ILogger<TradeStateMachine> logger)
    {
        _trade = trade;
        _validationService = validationService;
        _duplicateCheckService = duplicateCheckService;
        _tradeProcessingService = tradeProcessingService;
        _tradeRepository = tradeRepository;
        _tradeHistoryRepository = tradeHistoryRepository;
        _logger = logger;

        _machine = new StateMachine<TcrState, TcrTrigger>(
            () => _trade.CurrentState,
            s => _trade.CurrentState = s);

        ConfigureStateMachine();
    }

    private void ConfigureStateMachine()
    {
        // RECEIVED STATE
        _machine.Configure(TcrState.Received)
            .OnEntry(() => LogTcrReceived())
            .Permit(TcrTrigger.StartValidation, TcrState.ValidationInProgress);

        // VALIDATION IN PROGRESS STATE
        _machine.Configure(TcrState.ValidationInProgress)
            .OnEntryAsync(async () => await StartValidation())
            .Permit(TcrTrigger.ValidationSucceeded, TcrState.DuplicateCheckInProgress)
            .Permit(TcrTrigger.ValidationFailed, TcrState.Rejected);

        // DUPLICATE CHECK IN PROGRESS STATE
        _machine.Configure(TcrState.DuplicateCheckInProgress)
            .OnEntryAsync(async () => await StartDuplicateCheck())
            .Permit(TcrTrigger.NoDuplicateFound, TcrState.ReadyForProcessing)
            .Permit(TcrTrigger.DuplicateFound, TcrState.ReadyForProcessing);

        // READY FOR PROCESSING STATE
        _machine.Configure(TcrState.ReadyForProcessing)
            .PermitIf(TcrTrigger.CreateNew, TcrState.Created, () => _trade.HasRequiredFields())
            .PermitIf(TcrTrigger.UpdateExisting, TcrState.Updated, () => _trade.HasRequiredFields())
            .Permit(TcrTrigger.RejectTrade, TcrState.Rejected);

        // CREATED STATE
        _machine.Configure(TcrState.Created)
            .OnEntryAsync(async () => await CreateTradeRecord())
            .Permit(TcrTrigger.SaveSucceeded, TcrState.Saved)
            .Permit(TcrTrigger.SaveFailed, TcrState.Failed);

        // UPDATED STATE
        _machine.Configure(TcrState.Updated)
            .OnEntryAsync(async () => await UpdateTradeRecord())
            .Permit(TcrTrigger.SaveSucceeded, TcrState.Saved)
            .Permit(TcrTrigger.SaveFailed, TcrState.Failed);

        // REJECTED STATE
        _machine.Configure(TcrState.Rejected)
            .OnEntryAsync(async () => await RejectTrade())
            .Permit(TcrTrigger.SaveSucceeded, TcrState.Saved)
            .Permit(TcrTrigger.SaveFailed, TcrState.Failed);

        // SAVED STATE (Terminal)
        _machine.Configure(TcrState.Saved)
            .OnEntryAsync(async () => await PersistToDatabase());

        // FAILED STATE (Terminal with retry)
        _machine.Configure(TcrState.Failed)
            .OnEntryAsync(async () => await LogError())
            .PermitIf(TcrTrigger.Retry, TcrState.Received, () => _trade.IsRetryable());
    }

    public async Task<TcrState> FireAsync(TcrTrigger trigger)
    {
        var previousState = _trade.CurrentState;

        if (_machine.CanFire(trigger))
        {
            await _machine.FireAsync(trigger);
            await RecordStateTransition(previousState, _trade.CurrentState, trigger);
            await _tradeRepository.SaveChangesAsync();
            return _trade.CurrentState;
        }

        throw new InvalidOperationException(
            $"Cannot fire trigger '{trigger}' from state '{_trade.CurrentState}'");
    }

    public bool CanFire(TcrTrigger trigger) => _machine.CanFire(trigger);

    public IEnumerable<TcrTrigger> PermittedTriggers => _machine.PermittedTriggers;

    public TcrState CurrentState => _machine.State;

    // State entry actions
    private void LogTcrReceived()
    {
        _logger.LogInformation("Trade {TradeReference} received at {Timestamp}",
            _trade.TradeReference, DateTime.UtcNow);
        _trade.UpdatedAt = DateTime.UtcNow;
    }

    private async Task StartValidation()
    {
        _logger.LogInformation("Starting validation for trade {TradeReference}",
            _trade.TradeReference);

        var (isValid, errorMessage) = await _validationService.ValidateTradeAsync(_trade);
        _trade.IsValidated = isValid;
        _trade.ValidationErrors = errorMessage;
        _trade.UpdatedAt = DateTime.UtcNow;

        if (isValid)
        {
            await _machine.FireAsync(TcrTrigger.ValidationSucceeded);
        }
        else
        {
            await _machine.FireAsync(TcrTrigger.ValidationFailed);
        }
    }

    private async Task StartDuplicateCheck()
    {
        _logger.LogInformation("Starting duplicate check for trade {TradeReference}",
            _trade.TradeReference);

        var (isDuplicate, existingTradeId) = await _duplicateCheckService.CheckDuplicateAsync(_trade);
        _trade.IsDuplicate = isDuplicate;
        _trade.UpdatedAt = DateTime.UtcNow;

        if (isDuplicate)
        {
            _logger.LogWarning("Duplicate found for trade {TradeReference}. Existing trade: {ExistingTradeId}",
                _trade.TradeReference, existingTradeId);
            await _machine.FireAsync(TcrTrigger.DuplicateFound);
        }
        else
        {
            await _machine.FireAsync(TcrTrigger.NoDuplicateFound);
        }
    }

    private async Task CreateTradeRecord()
    {
        _logger.LogInformation("Creating trade record for {TradeReference}",
            _trade.TradeReference);

        try
        {
            await _tradeProcessingService.CreateTradeRecordAsync(_trade);
            _trade.UpdatedAt = DateTime.UtcNow;
            await _machine.FireAsync(TcrTrigger.SaveSucceeded);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to create trade record for {TradeReference}",
                _trade.TradeReference);
            _trade.ErrorMessage = ex.Message;
            await _machine.FireAsync(TcrTrigger.SaveFailed);
        }
    }

    private async Task UpdateTradeRecord()
    {
        _logger.LogInformation("Updating trade record for {TradeReference}",
            _trade.TradeReference);

        try
        {
            await _tradeProcessingService.UpdateTradeRecordAsync(_trade);
            _trade.UpdatedAt = DateTime.UtcNow;
            await _machine.FireAsync(TcrTrigger.SaveSucceeded);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to update trade record for {TradeReference}",
                _trade.TradeReference);
            _trade.ErrorMessage = ex.Message;
            await _machine.FireAsync(TcrTrigger.SaveFailed);
        }
    }

    private async Task RejectTrade()
    {
        _logger.LogWarning("Rejecting trade {TradeReference}", _trade.TradeReference);

        try
        {
            var reason = _trade.ValidationErrors ?? "Trade rejected";
            await _tradeProcessingService.RejectTradeAsync(_trade, reason);
            _trade.UpdatedAt = DateTime.UtcNow;
            await _machine.FireAsync(TcrTrigger.SaveSucceeded);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to reject trade {TradeReference}",
                _trade.TradeReference);
            _trade.ErrorMessage = ex.Message;
            await _machine.FireAsync(TcrTrigger.SaveFailed);
        }
    }

    private async Task PersistToDatabase()
    {
        _logger.LogInformation("Persisting trade {TradeReference} to database",
            _trade.TradeReference);

        await _tradeProcessingService.PersistToDatabaseAsync(_trade);
        _trade.UpdatedAt = DateTime.UtcNow;
    }

    private async Task LogError()
    {
        _logger.LogError("Trade {TradeReference} failed with error: {ErrorMessage}",
            _trade.TradeReference, _trade.ErrorMessage);

        _trade.RetryCount++;
        await _tradeProcessingService.LogErrorAsync(_trade, _trade.ErrorMessage ?? "Unknown error");
    }

    private async Task RecordStateTransition(TcrState fromState, TcrState toState, TcrTrigger trigger)
    {
        var history = new TradeHistory
        {
            Id = Guid.NewGuid(),
            TradeId = _trade.Id,
            FromState = fromState,
            ToState = toState,
            Trigger = trigger,
            TransitionedAt = DateTime.UtcNow
        };

        await _tradeHistoryRepository.CreateAsync(history);
    }
}
