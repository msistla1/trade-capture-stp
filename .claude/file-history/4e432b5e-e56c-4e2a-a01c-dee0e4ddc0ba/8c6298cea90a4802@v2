using FluentAssertions;
using Microsoft.EntityFrameworkCore;
using TradeWorkflow.Infrastructure.Data;
using TradeWorkflow.Infrastructure.Repositories;
using TradeWorkflow.Tests.Builders;
using Xunit;

namespace TradeWorkflow.Tests.Infrastructure;

public class TradeRepositoryTests : IDisposable
{
    private readonly TradeDbContext _context;
    private readonly TradeRepository _repository;

    public TradeRepositoryTests()
    {
        var options = new DbContextOptionsBuilder<TradeDbContext>()
            .UseInMemoryDatabase(databaseName: Guid.NewGuid().ToString())
            .Options;

        _context = new TradeDbContext(options);
        _repository = new TradeRepository(_context);
    }

    [Fact]
    public async Task CreateAsync_ShouldAddTradeToDatabase()
    {
        // Arrange
        var trade = TradeBuilder.Default().Build();

        // Act
        var result = await _repository.CreateAsync(trade);
        await _repository.SaveChangesAsync();

        // Assert
        result.Should().NotBeNull();
        result.Id.Should().Be(trade.Id);
        var savedTrade = await _context.Trades.FindAsync(trade.Id);
        savedTrade.Should().NotBeNull();
    }

    [Fact]
    public async Task GetByIdAsync_WhenTradeExists_ShouldReturnTrade()
    {
        // Arrange
        var trade = TradeBuilder.Default().Build();
        await _context.Trades.AddAsync(trade);
        await _context.SaveChangesAsync();

        // Act
        var result = await _repository.GetByIdAsync(trade.Id);

        // Assert
        result.Should().NotBeNull();
        result!.Id.Should().Be(trade.Id);
        result.TradeReference.Should().Be(trade.TradeReference);
    }

    [Fact]
    public async Task GetByIdAsync_WhenTradeDoesNotExist_ShouldReturnNull()
    {
        // Arrange
        var tradeId = Guid.NewGuid();

        // Act
        var result = await _repository.GetByIdAsync(tradeId);

        // Assert
        result.Should().BeNull();
    }

    [Fact]
    public async Task GetByTradeReferenceAsync_WhenTradeExists_ShouldReturnTrade()
    {
        // Arrange
        var trade = TradeBuilder.Default()
            .WithTradeReference("TRD-UNIQUE-001")
            .Build();
        await _context.Trades.AddAsync(trade);
        await _context.SaveChangesAsync();

        // Act
        var result = await _repository.GetByTradeReferenceAsync("TRD-UNIQUE-001");

        // Assert
        result.Should().NotBeNull();
        result!.TradeReference.Should().Be("TRD-UNIQUE-001");
    }

    [Fact]
    public async Task GetByTradeReferenceAsync_WhenTradeDoesNotExist_ShouldReturnNull()
    {
        // Act
        var result = await _repository.GetByTradeReferenceAsync("NON-EXISTENT");

        // Assert
        result.Should().BeNull();
    }

    [Fact]
    public async Task GetAllAsync_ShouldReturnAllTrades()
    {
        // Arrange
        var trade1 = TradeBuilder.Default().WithId(Guid.NewGuid()).Build();
        var trade2 = TradeBuilder.Default().WithId(Guid.NewGuid()).Build();
        await _context.Trades.AddRangeAsync(trade1, trade2);
        await _context.SaveChangesAsync();

        // Act
        var result = await _repository.GetAllAsync();

        // Assert
        result.Should().HaveCount(2);
    }

    [Fact]
    public async Task UpdateAsync_ShouldUpdateTradeInDatabase()
    {
        // Arrange
        var trade = TradeBuilder.Default().Build();
        await _context.Trades.AddAsync(trade);
        await _context.SaveChangesAsync();

        // Act
        trade.Price = 999.99m;
        await _repository.UpdateAsync(trade);
        await _repository.SaveChangesAsync();

        // Assert
        var updatedTrade = await _context.Trades.FindAsync(trade.Id);
        updatedTrade.Should().NotBeNull();
        updatedTrade!.Price.Should().Be(999.99m);
    }

    public void Dispose()
    {
        _context.Database.EnsureDeleted();
        _context.Dispose();
    }
}
