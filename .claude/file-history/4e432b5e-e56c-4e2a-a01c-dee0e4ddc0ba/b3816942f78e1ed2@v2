using TradeWorkflow.Domain.Entities;
using TradeWorkflow.Domain.Enums;

namespace TradeWorkflow.Tests.Builders;

public class TradeBuilder
{
    private Guid _id = Guid.NewGuid();
    private string _tradeReference = "TRD-001";
    private TcrState _currentState = TcrState.Received;
    private string _instrument = "AAPL";
    private decimal _quantity = 100;
    private decimal _price = 150.50m;
    private string _counterparty = "ABC Corp";
    private DateTime _tradeDate = DateTime.UtcNow;
    private string _tradeType = "Buy";
    private bool _isValidated = false;
    private bool _isDuplicate = false;
    private string? _validationErrors = null;
    private int _retryCount = 0;
    private int _maxRetries = 3;
    private DateTime _createdAt = DateTime.UtcNow;
    private DateTime _updatedAt = DateTime.UtcNow;
    private string? _errorMessage = null;

    public TradeBuilder WithId(Guid id)
    {
        _id = id;
        return this;
    }

    public TradeBuilder WithTradeReference(string tradeReference)
    {
        _tradeReference = tradeReference;
        return this;
    }

    public TradeBuilder WithState(TcrState state)
    {
        _currentState = state;
        return this;
    }

    public TradeBuilder WithInstrument(string instrument)
    {
        _instrument = instrument;
        return this;
    }

    public TradeBuilder WithQuantity(decimal quantity)
    {
        _quantity = quantity;
        return this;
    }

    public TradeBuilder WithPrice(decimal price)
    {
        _price = price;
        return this;
    }

    public TradeBuilder WithCounterparty(string counterparty)
    {
        _counterparty = counterparty;
        return this;
    }

    public TradeBuilder WithTradeDate(DateTime tradeDate)
    {
        _tradeDate = tradeDate;
        return this;
    }

    public TradeBuilder WithTradeType(string tradeType)
    {
        _tradeType = tradeType;
        return this;
    }

    public TradeBuilder Validated(bool isValidated = true)
    {
        _isValidated = isValidated;
        return this;
    }

    public TradeBuilder IsDuplicate(bool isDuplicate = true)
    {
        _isDuplicate = isDuplicate;
        return this;
    }

    public TradeBuilder WithValidationErrors(string errors)
    {
        _validationErrors = errors;
        return this;
    }

    public TradeBuilder WithRetryCount(int count)
    {
        _retryCount = count;
        return this;
    }

    public TradeBuilder WithMaxRetries(int max)
    {
        _maxRetries = max;
        return this;
    }

    public TradeBuilder WithErrorMessage(string message)
    {
        _errorMessage = message;
        return this;
    }

    public TradeBuilder WithInvalidFields()
    {
        _tradeReference = "";
        _quantity = 0;
        _price = 0;
        return this;
    }

    public Trade Build()
    {
        return new Trade
        {
            Id = _id,
            TradeReference = _tradeReference,
            CurrentState = _currentState,
            Instrument = _instrument,
            Quantity = _quantity,
            Price = _price,
            Counterparty = _counterparty,
            TradeDate = _tradeDate,
            TradeType = _tradeType,
            IsValidated = _isValidated,
            IsDuplicate = _isDuplicate,
            ValidationErrors = _validationErrors,
            RetryCount = _retryCount,
            MaxRetries = _maxRetries,
            CreatedAt = _createdAt,
            UpdatedAt = _updatedAt,
            ErrorMessage = _errorMessage
        };
    }

    public static TradeBuilder Default() => new TradeBuilder();
}
