using Shared.Contracts.Enums;
using System.ComponentModel.DataAnnotations;

namespace Shared.Contracts.DTOs;

// User's trade submission from UI
public record TradeSubmission
{
    [Required]
    [StringLength(50)]
    public string SecurityId { get; init; } = string.Empty;

    [Required]
    [StringLength(50)]
    public string CounterpartyId { get; init; } = string.Empty;

    [Required]
    [Range(0.01, double.MaxValue)]
    public decimal TotalAmount { get; init; }

    [Required]
    [Range(0.01, double.MaxValue)]
    public decimal Price { get; init; }

    [Required]
    public DateTime TradeDate { get; init; }

    [Required]
    [MinLength(1)]
    public List<string> SelectedFunds { get; init; } = new();

    [Required]
    public string StrategyId { get; init; } = string.Empty;

    [Required]
    public AllocationMethodology AllocationMethodology { get; init; }

    public CustomAllocationRules? CustomRules { get; init; }

    [Required]
    [StringLength(100)]
    public string UserId { get; init; } = string.Empty;

    public string Currency { get; init; } = "USD";
}

// Partial approval request
public record PartialApprovalRequest(
    List<string> ApprovedFundIds,
    string UserId,
    string? Comments = null
);

// Orchestration response
public record OrchestrationResponse
{
    public string RequestId { get; init; } = string.Empty;
    public OrchestrationStatus Status { get; init; }
    public ComplianceResponse? ComplianceResult { get; init; }
    public AllocationResponse? AllocationResult { get; init; }
    public TradeBookingResponse? BookingResult { get; init; }
    public string? Message { get; init; }
    public List<string> Errors { get; init; } = new();

    public static OrchestrationResponse Success(
        string requestId,
        ComplianceResponse compliance,
        AllocationResponse allocation,
        TradeBookingResponse booking) => new()
        {
            RequestId = requestId,
            Status = OrchestrationStatus.Completed,
            ComplianceResult = compliance,
            AllocationResult = allocation,
            BookingResult = booking,
            Message = "Trade successfully booked"
        };

    public static OrchestrationResponse AwaitingApproval(
        string requestId,
        ComplianceResponse compliance) => new()
        {
            RequestId = requestId,
            Status = OrchestrationStatus.AwaitingApproval,
            ComplianceResult = compliance,
            Message = "Some funds failed compliance. User approval required."
        };

    public static OrchestrationResponse Failed(
        string requestId,
        string message,
        ComplianceResponse? compliance = null) => new()
        {
            RequestId = requestId,
            Status = OrchestrationStatus.Failed,
            ComplianceResult = compliance,
            Message = message,
            Errors = new List<string> { message }
        };
}

// Orchestration state
public record OrchestrationState(
    string RequestId,
    OrchestrationStatus Status,
    string CurrentStep,
    TradeSubmission Submission,
    ComplianceResponse? ComplianceResult = null,
    AllocationResponse? AllocationResult = null,
    TradeBookingResponse? BookingResult = null,
    DateTime CreatedAt = default,
    DateTime UpdatedAt = default,
    DateTime? CompletedAt = null,
    string? ErrorMessage = null
);
