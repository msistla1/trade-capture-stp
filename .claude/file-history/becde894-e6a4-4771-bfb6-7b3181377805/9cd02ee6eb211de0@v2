namespace Shared.Contracts.ValueObjects;

/// <summary>
/// Value object representing a percentage value (0-100)
/// </summary>
public record Percentage
{
    public decimal Value { get; init; }

    public Percentage(decimal value)
    {
        if (value < 0 || value > 100)
            throw new ArgumentException("Percentage must be between 0 and 100", nameof(value));

        Value = value;
    }

    public decimal AsDecimal() => Value / 100m;

    public decimal ApplyTo(decimal amount) => amount * AsDecimal();

    public override string ToString() => $"{Value:N2}%";
}
