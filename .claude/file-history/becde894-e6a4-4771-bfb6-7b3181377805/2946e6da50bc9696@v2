using Microsoft.CodeAnalysis.CSharp.Scripting;
using Microsoft.CodeAnalysis.Scripting;
using System.Collections.Concurrent;

namespace Compliance.Domain.RuleEngine;

public interface IScriptEngine
{
    Task<T> EvaluateAsync<T>(string expression, Dictionary<string, object> globals);
}

public class RoslynScriptEngine : IScriptEngine
{
    private readonly ConcurrentDictionary<string, Script> _compiledScripts = new();

    public async Task<T> EvaluateAsync<T>(
        string expression,
        Dictionary<string, object> globals)
    {
        var script = _compiledScripts.GetOrAdd(expression, expr =>
        {
            var options = ScriptOptions.Default
                .AddReferences(typeof(Fund).Assembly, typeof(List<>).Assembly)
                .AddImports("System", "System.Linq", "System.Collections.Generic");

            return CSharpScript.Create<T>(expr, options, typeof(ScriptGlobals));
        });

        var globalsObject = new ScriptGlobals(globals);
        var result = await script.RunAsync(globalsObject);
        return result.ReturnValue;
    }
}

// Globals available in script expressions
public class ScriptGlobals
{
    public dynamic fund { get; set; } = null!;
    public dynamic security { get; set; } = null!;
    public dynamic trade { get; set; } = null!;
    public dynamic portfolio { get; set; } = null!;
    public dynamic parameters { get; set; } = null!;

    public ScriptGlobals(Dictionary<string, object> values)
    {
        if (values.ContainsKey("fund")) fund = values["fund"];
        if (values.ContainsKey("security")) security = values["security"];
        if (values.ContainsKey("trade")) trade = values["trade"];
        if (values.ContainsKey("portfolio")) portfolio = values["portfolio"];
        if (values.ContainsKey("parameters")) parameters = values["parameters"];
    }
}
