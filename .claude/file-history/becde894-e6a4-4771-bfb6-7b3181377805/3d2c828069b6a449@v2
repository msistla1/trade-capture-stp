using Shared.Contracts.DTOs;
using Shared.Contracts.Enums;

namespace Allocation.API.Strategies;

public class CustomAllocationStrategy : IAllocationStrategy
{
    public AllocationResponse Allocate(AllocationRequest request)
    {
        var customRules = request.CustomRules
            ?? throw new ArgumentException("Custom rules required for custom allocation");

        var allocations = new List<FundAllocation>();
        var totalAllocated = 0m;
        var warnings = new List<string>();

        // Calculate weighted allocations
        var totalWeight = request.Funds.Sum(f => f.Weight ?? 0);

        if (totalWeight <= 0)
        {
            throw new InvalidOperationException("Total weight must be greater than zero");
        }

        var fundsWithCapacity = request.Funds
            .Where(f => f.AvailableCapacity > 0)
            .OrderByDescending(f => f.Priority)
            .ToList();

        // First pass: allocate by weight
        var firstPassAllocations = new Dictionary<string, decimal>();

        foreach (var fund in fundsWithCapacity)
        {
            var weight = fund.Weight ?? 0;
            var weightedAmount = request.TotalAmount * (weight / totalWeight);
            var allocatedAmount = Math.Min(weightedAmount, fund.AvailableCapacity);

            firstPassAllocations[fund.FundId] = allocatedAmount;
            totalAllocated += allocatedAmount;
        }

        // Second pass: reallocate shortfall
        if (totalAllocated < request.TotalAmount)
        {
            var shortfall = request.TotalAmount - totalAllocated;
            warnings.Add($"Initial allocation left {shortfall:C} unallocated");

            // Redistribute to funds with remaining capacity
            var fundsWithRoom = fundsWithCapacity
                .Where(f => firstPassAllocations[f.FundId] < f.AvailableCapacity)
                .OrderByDescending(f => f.Priority)
                .ToList();

            foreach (var fund in fundsWithRoom)
            {
                if (shortfall <= 0) break;

                var currentAllocation = firstPassAllocations[fund.FundId];
                var remainingCapacity = fund.AvailableCapacity - currentAllocation;
                var additionalAmount = Math.Min(shortfall, remainingCapacity);

                firstPassAllocations[fund.FundId] += additionalAmount;
                totalAllocated += additionalAmount;
                shortfall -= additionalAmount;

                warnings.Add(
                    $"Reallocated {additionalAmount:C} to {fund.FundId} (priority {fund.Priority})");
            }
        }

        // Create final allocations
        foreach (var kvp in firstPassAllocations.Where(a => a.Value > 0))
        {
            allocations.Add(new FundAllocation(
                kvp.Key,
                kvp.Value,
                kvp.Value / request.Price,
                (kvp.Value / request.TotalAmount) * 100m,
                AllocationStatus.Allocated,
                null
            ));
        }

        var summary = new AllocationSummary(
            request.TotalAmount,
            totalAllocated,
            request.TotalAmount - totalAllocated,
            totalAllocated == request.TotalAmount,
            warnings
        );

        return new AllocationResponse(
            request.RequestId,
            allocations,
            summary
        );
    }
}
