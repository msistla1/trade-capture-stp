using Shared.Contracts.DTOs;
using Shared.Contracts.Enums;

namespace Allocation.API.Strategies;

public class ProRataAllocationStrategy : IAllocationStrategy
{
    public AllocationResponse Allocate(AllocationRequest request)
    {
        var totalCapacity = request.Funds.Sum(f => f.AvailableCapacity);

        if (totalCapacity <= 0)
        {
            return new AllocationResponse(
                request.RequestId,
                new List<FundAllocation>(),
                new AllocationSummary(
                    request.TotalAmount,
                    0m,
                    request.TotalAmount,
                    false,
                    new List<string> { "No available capacity across all funds" }
                )
            );
        }

        var allocations = new List<FundAllocation>();
        var totalAllocated = 0m;

        // Calculate proportional allocations
        foreach (var fund in request.Funds.Where(f => f.AvailableCapacity > 0))
        {
            var proportion = fund.AvailableCapacity / totalCapacity;
            var desiredAmount = request.TotalAmount * proportion;
            var allocatedAmount = Math.Min(desiredAmount, fund.AvailableCapacity);

            allocations.Add(new FundAllocation(
                fund.FundId,
                allocatedAmount,
                allocatedAmount / request.Price,
                (allocatedAmount / request.TotalAmount) * 100m,
                AllocationStatus.Allocated,
                null
            ));

            totalAllocated += allocatedAmount;
        }

        // Handle rounding adjustments
        if (totalAllocated < request.TotalAmount && allocations.Any())
        {
            var shortage = request.TotalAmount - totalAllocated;

            // Allocate remaining to fund with most remaining capacity
            var fundWithMostRoom = allocations
                .Select(a => new
                {
                    Allocation = a,
                    RemainingCapacity = request.Funds
                        .First(f => f.FundId == a.FundId).AvailableCapacity - a.AllocatedAmount
                })
                .OrderByDescending(x => x.RemainingCapacity)
                .FirstOrDefault();

            if (fundWithMostRoom != null && fundWithMostRoom.RemainingCapacity >= shortage)
            {
                var index = allocations.IndexOf(fundWithMostRoom.Allocation);
                var updatedAllocation = fundWithMostRoom.Allocation with
                {
                    AllocatedAmount = fundWithMostRoom.Allocation.AllocatedAmount + shortage,
                    AllocatedShares = (fundWithMostRoom.Allocation.AllocatedAmount + shortage) / request.Price,
                    PercentageOfTotal = ((fundWithMostRoom.Allocation.AllocatedAmount + shortage) / request.TotalAmount) * 100m
                };

                allocations[index] = updatedAllocation;
                totalAllocated += shortage;
            }
        }

        var summary = new AllocationSummary(
            request.TotalAmount,
            totalAllocated,
            request.TotalAmount - totalAllocated,
            totalAllocated == request.TotalAmount,
            new List<string>()
        );

        return new AllocationResponse(
            request.RequestId,
            allocations,
            summary
        );
    }
}
