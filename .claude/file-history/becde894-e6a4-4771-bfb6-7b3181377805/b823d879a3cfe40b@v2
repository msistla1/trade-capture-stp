namespace Shared.Contracts.ValueObjects;

/// <summary>
/// Value object representing a price per unit
/// </summary>
public record Price(decimal Value, string Currency)
{
    public Money CalculateAmount(decimal quantity) =>
        new Money(Value * quantity, Currency);

    public bool IsValid() => Value > 0;

    public override string ToString() => $"{Value:N4} {Currency}";
}
