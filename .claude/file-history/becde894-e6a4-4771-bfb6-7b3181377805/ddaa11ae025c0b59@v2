using Shared.Contracts.Enums;
using Shared.Contracts.ValueObjects;

namespace Shared.Contracts.Entities;

public record Trade
{
    public Guid Id { get; init; }
    public string SecurityId { get; init; } = string.Empty;
    public string CounterpartyId { get; init; } = string.Empty;
    public Money TotalAmount { get; init; } = new Money(0, "USD");
    public Price Price { get; init; } = new Price(0, "USD");
    public TradeDate TradeDate { get; init; } = new TradeDate(DateTime.UtcNow);
    public DateTime SettlementDate { get; init; }
    public string TradeType { get; init; } = string.Empty;
    public TradeStatus Status { get; init; }
    public string CreatedBy { get; init; } = string.Empty;
    public DateTime CreatedAt { get; init; }
    public string? ApprovedBy { get; init; }
    public DateTime? ApprovedAt { get; init; }

    public IReadOnlyList<TradeAllocation> Allocations { get; init; } = new List<TradeAllocation>();
}

public record TradeAllocation
{
    public Guid Id { get; init; }
    public Guid TradeId { get; init; }
    public string FundId { get; init; } = string.Empty;
    public Money AllocatedAmount { get; init; } = new Money(0, "USD");
    public decimal Shares { get; init; }
    public decimal PercentageOfTotal { get; init; }
    public AllocationStatus Status { get; init; }
    public string ConfirmationNumber { get; init; } = string.Empty;
    public DateTime CreatedAt { get; init; }
}
