namespace Shared.Contracts.ValueObjects;

/// <summary>
/// Value object representing a trade date with settlement calculation
/// </summary>
public record TradeDate(DateTime Date)
{
    public DateTime SettlementDate(int settlementDays = 2) =>
        Date.AddBusinessDays(settlementDays);

    public bool IsValid() => Date.Date <= DateTime.UtcNow.Date;

    public override string ToString() => Date.ToString("yyyy-MM-dd");
}

public static class DateTimeExtensions
{
    public static DateTime AddBusinessDays(this DateTime date, int days)
    {
        if (days == 0) return date;

        var direction = days > 0 ? 1 : -1;
        var unsignedDays = Math.Abs(days);
        var result = date;

        for (int i = 0; i < unsignedDays; i++)
        {
            do
            {
                result = result.AddDays(direction);
            }
            while (result.DayOfWeek == DayOfWeek.Saturday || result.DayOfWeek == DayOfWeek.Sunday);
        }

        return result;
    }
}
