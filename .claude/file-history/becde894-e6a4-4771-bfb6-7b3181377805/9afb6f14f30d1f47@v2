using Compliance.API.Services;
using Compliance.Infrastructure.Repositories;
using Microsoft.AspNetCore.Mvc;
using Shared.Contracts.DTOs;
using Shared.Contracts.Entities;

namespace Compliance.API.Controllers;

[ApiController]
[Route("api/[controller]")]
public class ComplianceController : ControllerBase
{
    private readonly IComplianceService _complianceService;
    private readonly IComplianceRuleRepository _ruleRepository;
    private readonly ILogger<ComplianceController> _logger;

    public ComplianceController(
        IComplianceService complianceService,
        IComplianceRuleRepository ruleRepository,
        ILogger<ComplianceController> logger)
    {
        _complianceService = complianceService;
        _ruleRepository = ruleRepository;
        _logger = logger;
    }

    [HttpPost("evaluate")]
    [ProducesResponseType(typeof(ComplianceResponse), 200)]
    [ProducesResponseType(typeof(ProblemDetails), 400)]
    public async Task<ActionResult<ComplianceResponse>> Evaluate(
        [FromBody] ComplianceRequest request)
    {
        if (!ModelState.IsValid)
            return BadRequest(ModelState);

        _logger.LogInformation(
            "Received compliance evaluation request for security {SecurityId} with {FundCount} funds",
            request.SecurityId,
            request.FundIds.Count);

        var response = await _complianceService.EvaluateAsync(request);

        return Ok(response);
    }

    [HttpGet("rules/{fundId}")]
    [ProducesResponseType(typeof(List<ComplianceRule>), 200)]
    public async Task<ActionResult<List<ComplianceRule>>> GetRules(string fundId)
    {
        var rules = await _ruleRepository.GetActiveRulesAsync(fundId, DateTime.UtcNow);
        return Ok(rules);
    }

    [HttpGet("health")]
    public IActionResult Health()
    {
        return Ok(new { status = "healthy", service = "Compliance.API" });
    }
}
