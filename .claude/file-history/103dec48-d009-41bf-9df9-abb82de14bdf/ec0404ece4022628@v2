using Aurora.AllocationEngine.Interfaces;
using Aurora.AllocationEngine.Models;
using Microsoft.Extensions.Logging;

namespace Aurora.AllocationEngine.Strategies;

public class ProRataAllocationStrategy : IAllocationStrategy
{
    private readonly ILogger<ProRataAllocationStrategy> _logger;

    public ProRataAllocationStrategy(ILogger<ProRataAllocationStrategy> logger)
    {
        _logger = logger;
    }

    public async Task<List<AllocationResult>> AllocateAsync(AllocationRequest request, CancellationToken cancellationToken = default)
    {
        _logger.LogInformation("Executing Pro-Rata allocation for trade {TradeRef}", request.Trade.TradeReference);

        var allocations = new List<AllocationResult>();

        // Get only funds that passed compliance
        var eligibleFunds = request.ComplianceResults.FundResults
            .Where(f => f.Passed)
            .ToList();

        if (!eligibleFunds.Any())
        {
            _logger.LogWarning("No eligible funds for allocation");
            return allocations;
        }

        // Calculate total available capacity across all funds
        var totalCapacity = eligibleFunds.Sum(f => Math.Min(f.AvailableCapacity, f.Fund.AvailableCash));

        if (totalCapacity == 0)
        {
            _logger.LogWarning("Total available capacity is zero");
            return allocations;
        }

        var totalToAllocate = Math.Min(request.Trade.TotalTradeAmount, totalCapacity);

        foreach (var fundResult in eligibleFunds)
        {
            var fund = fundResult.Fund;
            var effectiveCapacity = Math.Min(fundResult.AvailableCapacity, fund.AvailableCash);

            // Calculate pro-rata allocation based on capacity
            var allocationPercentage = effectiveCapacity / totalCapacity;
            var allocatedAmount = totalToAllocate * allocationPercentage;

            // Ensure we don't exceed fund capacity or available cash
            allocatedAmount = Math.Min(allocatedAmount, effectiveCapacity);

            if (allocatedAmount > 0)
            {
                allocations.Add(new AllocationResult
                {
                    Fund = fund,
                    AllocatedAmount = allocatedAmount,
                    AllocatedQuantity = allocatedAmount / request.Trade.Price,
                    AllocationPercentage = (allocatedAmount / request.Trade.TotalTradeAmount) * 100,
                    AvailableCapacity = fundResult.AvailableCapacity,
                    AllocationReason = $"Pro-Rata based on capacity ({allocationPercentage:P2})"
                });
            }
        }

        _logger.LogInformation("Pro-Rata allocation completed: {FundCount} funds, Total: {Total:C}",
            allocations.Count, allocations.Sum(a => a.AllocatedAmount));

        return await Task.FromResult(allocations);
    }
}
